# Скопируйте в .env. Настоящие значения заполняйте только на ZimaOS.
YANDEX_EMAIL=
YANDEX_APP_PASSWORD=
YANDEX_IMAP_HOST=imap.yandex.ru
YANDEX_IMAP_PORT=993
YANDEX_ARCHIVE_FOLDER=Archive
# Случайный токен: openssl rand -hex 32. Обязателен; минимум 32 символа.
MCP_BEARER_TOKEN=
# Необязательный отдельный токен только для чтения; отличен от основного.
MCP_READ_ONLY_TOKEN=
# false полностью запрещает вызовы инструментов записи.
MCP_ENABLE_WRITE=true
# Включить после настройки Authentik по AUTHENTIK.md.
MCP_OAUTH_ENABLED=false
MCP_ALLOWED_HOSTS=mail-mcp.example.com,mail-mcp.example.com:443,127.0.0.1:8000,127.0.0.1:8822,localhost:8000,localhost:8822
MCP_ALLOWED_ORIGINS=https://mail-mcp.example.com
# При NPM в другом контейнере оставьте 0.0.0.0 и ограничьте доступ firewall.
MCP_BIND_IP=0.0.0.0

# Обязательны при MCP_OAUTH_ENABLED=true. Точное совпадение issuer и audience.
MCP_PUBLIC_URL=https://mail-mcp.example.com/mcp
OAUTH_ISSUER=https://auth.example.com/application/o/yandex-mail-mcp/
OAUTH_CLIENT_ID=
# Пустое значение использует OAUTH_ISSUER + jwks/
OAUTH_JWKS_URL=
# Optional HTTPS route to the same issuer host/path through an internal proxy port.
# Example: https://auth.example.com:18443/application/o/yandex-mail-mcp/
OAUTH_BACKCHANNEL_URL=
MCP_STATE_DIR=/data
